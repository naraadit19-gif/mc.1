FROM node:20-slim
WORKDIR /app
# ffmpeg dipakai worker media (potong, gabung video, hapus watermark, pasang audio asli)
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY . .
ENV PORT=8080
EXPOSE 8080
CMD ["node", "server.js"]
